# Configuracion del panel SimuladorFiscalGO
# Lo lee compilar_y_ejecutar.bat (formato CLAVE=VALOR, sin espacios)
HOST=127.0.0.1
# Puerto preferido; si esta ocupado, el .bat busca el siguiente libre
PORT=8787
# Carpeta de estado persistido por marca
DATA_DIR=data
# 1 = no abrir el navegador automaticamente
NO_BROWSER=0
